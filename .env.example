# Скопируйте в .env и заполните. Файл .env НЕ коммитьте — он в .gitignore.

# --- Обязательно ---------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExamp

# Telegram ID мастера. Узнать: написать @userinfobot. Несколько — через запятую.
ADMIN_IDS=123456789

# --- Часовой пояс салона ------------------------------------------------
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Krasnoyarsk

# --- Необязательно ------------------------------------------------------
# На хостинге оставьте эту строку закомментированной: прокси там не нужен,
# а неверный адрес не даст боту подключиться к Telegram вообще.
# PROXY_URL=socks5://127.0.0.1:10808

# Что видят клиенты в разделе «Контакты»
# SALON_NAME=Nail Studio
# SALON_ADDRESS=ул. Примерная, 1
# SALON_PHONE=+7 900 000-00-00
# CURRENCY=₽

# Где хранится база. По умолчанию data/bookings.db — на Bothost это
# /app/data/bookings.db: персистентная папка, которая не затирается при
# обновлении кода из Git. Менять нужно только если папка другая.
# DB_PATH=data/bookings.db
